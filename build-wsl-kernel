          auto_fixed=0
          missing_list=()
          
          for feat in "${!features[@]}"; do
            if ! grep -q "^$feat=${features[$feat]}$" .config; then
              missing_list+=("$feat")
              echo "[FIX] Tính năng '$feat' bị thiếu hoặc sai giá trị!"
              sed -i "/^#\? \?$feat[= ]/d" .config
              echo "$feat=${features[$feat]}" >> .config
              auto_fixed=1
            fi
          done
          
          if [ $auto_fixed -eq 1 ]; then
            echo "--- Đã tự động vá các tính năng: ${missing_list[*]} ---"
