name: Build Custom WSL2 Kernel
on: [push, workflow_dispatch]

jobs:
  build:
    runs-on: ubuntu-latest
    container: archlinux:latest
    timeout-minutes: 350
    steps:
      - name: Install Dependencies
        run: |
          pacman -Syu --noconfirm
          packages=(git base-devel bc bison flex pahole libelf elfutils openssl zstd kmod cpio gawk gcc llvm clang lld ccache patch curl pigz)
          for pkg in "${packages[@]}"; do pacman -S --noconfirm "$pkg"; done

      - name: Setup ccache
        run: |
          mkdir -p /tmp/ccache
          echo "CCACHE_DIR=/tmp/ccache" >> $GITHUB_ENV

      - name: Cache ccache
        uses: actions/cache@v4
        with:
          path: /tmp/ccache
          key: ${{ runner.os }}-kernel-k501lb-${{ github.sha }}
          restore-keys: ${{ runner.os }}-kernel-k501lb-

      - name: Build Kernel
        run: |
          git clone --depth=1 https://github.com/microsoft/WSL2-Linux-Kernel.git .
          curl -L --retry 3 -o prjc.patch https://raw.githubusercontent.com/cachyos/kernel-patches/master/6.18/sched/0001-prjc-cachy.patch
          patch -p1 --ignore-whitespace --fuzz=3 < prjc.patch
          export CC="ccache gcc"
          export CXX="ccache g++"
          
          make mrproper
          cp Microsoft/config-wsl .config
          
          cat <<EOF >> .config
          CONFIG_DEBUG_INFO=n
          CONFIG_DEBUG_KERNEL=n
          CONFIG_DEBUG_INFO_DWARF5=n
          CONFIG_DEBUG_INFO_BTF=n
          CONFIG_DEBUG_FS=n
          CONFIG_DEBUG_SECTION_MISMATCH=n
          CONFIG_DEBUG_LIST=n
          CONFIG_DEBUG_SG=n
          CONFIG_DEBUG_NOTIFIERS=n
          CONFIG_DYNAMIC_DEBUG=n
          CONFIG_MODULES=y
          CONFIG_MODULE_UNLOAD=y
          CONFIG_MODVERSIONS=y
          CONFIG_KERNEL_ZSTD=y
          CONFIG_RD_ZSTD=y
          CONFIG_CRYPTO_ZSTD=y
          CONFIG_ZSTD_COMMON=y
          CONFIG_ZSTD_COMPRESS=y
          CONFIG_ZSTD_DECOMPRESS=y
          CONFIG_ZSTD_CC_COMPRESS=y
          CONFIG_ZSTD_CC_DECOMPRESS=y
          CONFIG_ZSTD_CC_COMMON=y
          CONFIG_ZSTD_CC_COMPRESS_LIB=y
          CONFIG_ZSTD_CC_DECOMPRESS_LIB=y
          CONFIG_PREEMPT_DYNAMIC=y
          CONFIG_PREEMPT=y
          CONFIG_HZ_1000=y
          CONFIG_MCORE2=y
          CONFIG_SCHED_AUTOGROUP=y
          CONFIG_INTEL_PSTATE=y
          CONFIG_MITIGATIONS=y
          CONFIG_ZRAM=y
          CONFIG_PSI=y
          CONFIG_KSM=y
          CONFIG_LRU_GEN=y
