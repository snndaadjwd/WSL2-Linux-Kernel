          CONFIG_THERMAL_GOV_BANG_BANG=y
          CONFIG_INTEL_POWERCLAMP=y
          CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
          CONFIG_GCC_PLUGINS=y
          CONFIG_EXT4_FS=y
          CONFIG_EXT4_USE_FOR_EXT2=y
          CONFIG_F2FS_STAT_FS=y
          CONFIG_F2FS_FS_COMPRESSION=y
          CONFIG_NET_UDP_TUNNEL=y
          CONFIG_NET_TCPPROBE=y
          CONFIG_WATCHDOG=y
          CONFIG_SOFT_WATCHDOG=y
          CONFIG_LOCKUP_DETECTOR=y
          CONFIG_PANIC_ON_OOPS=y
          CONFIG_NET_SCH_FQ=y
          CONFIG_NET_SCH_CODEL=y
          CONFIG_NET_SCH_PIE=y
          CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
          CONFIG_CPU_FREQ_GOV_USERSPACE=y
          CONFIG_CPU_FREQ_GOV_ONDEMAND=y
          CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
          CONFIG_PACKET=y
          CONFIG_PACKET_DIAG=y
          CONFIG_FILTER=y
          CONFIG_NET_PKTGEN=y
          CONFIG_NETFILTER_NETLINK=y
          CONFIG_NETFILTER_NETLINK_ACCT=y
          CONFIG_NETFILTER_NETLINK_QUEUE=y
          CONFIG_NETFILTER_NETLINK_LOG=y
          CONFIG_NF_CT_NETLINK=y
          CONFIG_NF_LOG_NETDEV=y
          CONFIG_NETFILTER_XT_MATCH_BPF=y
          CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
          CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
          CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
          CONFIG_NETFILTER_XT_MATCH_LENGTH=y
          CONFIG_NETFILTER_XT_MATCH_LIMIT=y
          CONFIG_NETFILTER_XT_MATCH_MAC=y
          CONFIG_NETFILTER_XT_MATCH_MARK=y
          CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
          CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
          CONFIG_NETFILTER_XT_MATCH_STATE=y
          CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
          CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
          CONFIG_NETFILTER_XT_TARGET_LOG=y
          CONFIG_TUN=y
          CONFIG_TAP=y
          CONFIG_VXLAN=y
          CONFIG_L2TP=y
          CONFIG_GRE=y
          CONFIG_BRIDGE_VLAN_FILTERING=y
          CONFIG_FUSE_FS=y
          CONFIG_CUSE=y
          CONFIG_POSIX_MQUEUE=y
          CONFIG_SECCOMP_FILTER=y
          CONFIG_KEY_DH_OPERATIONS=y
          CONFIG_SCHED_BORE=n
          CONFIG_SCHED_PRJC=y
          CONFIG_PREEMPT_DYNAMIC=y
          CONFIG_SCHED_CORE=y
          CONFIG_SCHED_ALT_CORE=y
          CONFIG_TASK_DELAY_ACCT=y
          CONFIG_TASK_XACCT=y
          CONFIG_TASK_IO_ACCOUNTING=y
          CONFIG_MEMCG_SWAP=y
          CONFIG_MEMCG_KMEM=y
          CONFIG_HZ=1000
          CONFIG_KALLSYMS=y
          CONFIG_KALLSYMS_ALL=y
          CONFIG_FRAME_POINTER=y
          EOF
          
          make olddefconfig

          make -j$(nproc)
          
          mkdir -p /tmp/wsl_out
          cp arch/x86/boot/bzImage /tmp/wsl_out/bzImage
          make modules_install INSTALL_MOD_PATH=/tmp/wsl_out
          
          find /tmp/wsl_out/lib/modules -name "*.ko" -exec strip --strip-debug {} +
          find /tmp/wsl_out/lib/modules -name "build" -exec rm -rf {} +
          find /tmp/wsl_out/lib/modules -name "source" -exec rm -rf {} +
          
          cd /tmp/wsl_out
          tar -cf - lib/ | pigz -p2 > modules.tar.gz
          rm -rf lib/
          
      - name: Run Auto-Test in QEMU
        run: |
          pacman -S --noconfirm qemu-system-x86
          
          KVM_FLAGS=""
          if [ -e /dev/kvm ] && [ -w /dev/kvm ]; then
            echo "--- Phát hiện KVM, kích hoạt tăng tốc phần cứng ---"
            KVM_FLAGS="-enable-kvm"
          else
            echo "--- KHÔNG tìm thấy KVM hoặc thiếu quyền, chạy giả lập (chậm hơn) ---"
          fi
          
          echo "Đang test boot kernel..."
          
          timeout 90m qemu-system-x86_64 \
            $KVM_FLAGS \
            -kernel arch/x86/boot/bzImage \
            -append "console=ttyS0 panic=1 quiet" \
            -display none \
            -serial stdio \
            -smp 4 \
            -m 999M \
            -no-reboot
            
          EXIT_CODE=$?
          
          if [ $EXIT_CODE -eq 0 ]; then
            echo "SUCCESS: Kernel chạy xong không lỗi!"
          elif [ $EXIT_CODE -eq 124 ]; then
            echo "PANIC: Kernel bị treo cứng (Deadlock) sau 45 phút!"
            exit 1
          else
            echo "PANIC: Kernel bị crash với mã lỗi $EXIT_CODE!"
            echo "--- Dòng log cuối cùng trước khi crash ---"
            dmesg | tail -n 20 || echo "Không thể lấy log từ hệ thống."
            exit 1
          fi
          
      - name: Verify and Apply Kernel Features
        run: |
          echo "--- Đang kiểm tra tính năng trong .config ---"
          declare -A features=( 
            ["CONFIG_MODULES"]="y"
            ["CONFIG_MODULE_UNLOAD"]="y"
